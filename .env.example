# SerpApi key (SERPAPI_KEY also accepted). When unset, TripShock runs on the deterministic
# mock provider, clearly labelled "Simulated" in the UI.
SERPAPI_API_KEY=

# Force a provider: "serpapi" | "mock". Defaults to serpapi when a key is present, otherwise mock.
TRIPSHOCK_PROVIDER=

# SQLite file path (":memory:" for tests)
TRIPSHOCK_DB=data/tripshock.db

# Observations younger than this are reused instead of re-querying (minutes)
TRIPSHOCK_CACHE_TTL_MIN=30

# "Describe your trip" (voice/text → plan). Without a key the describe box is disabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# Tried in order when the primary is rate-limited or returns unusable output
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
